generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Marketplace {
  MERCADO_LIVRE
  SHOPEE
}

enum ProductIdentityProvider {
  MERCADO_LIVRE
  OLIST
  SHOPEE
}

enum MarketplaceOrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
  UNKNOWN
}

enum MarketplaceOrderBackfillStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum DailySellerMetricName {
  SALES_COUNT
  UNITS_SOLD
  GROSS_SALES
  MARGIN_RATE
  FULL_SALES_COUNT
  FULL_UNITS_SOLD
  FULL_GROSS_SALES
  VISITS
  AVERAGE_TICKET
  CONVERSION_RATE
}

enum DailySellerMetricSource {
  MERCADO_LIVRE
  OLIST
  GEFINANCE
  DERIVED
}

enum DailySellerMetricStatus {
  AVAILABLE
  UNAVAILABLE
  INCOMPATIBLE_SEMANTICS
  PROVISIONAL
}

enum DailySellerMetricConfidence {
  HIGH
  MEDIUM
  LOW
}

enum OfferCompositionSource {
  MANUAL
  CATALOG
  MARKETPLACE
  INFERRED
}

enum ListingEquivalenceStatus {
  CANDIDATE
  CONFIRMED
  REJECTED
}

model Product {
  id                 String                    @id @default(uuid()) @db.Uuid
  sku                String                    @unique(map: "products_sku_key")
  name               String
  active             Boolean                   @default(true)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  externalIdentities ProductExternalIdentity[]
  listingItems       MarketplaceListingItem[]
  orderItems         MarketplaceOrderItem[]
  offerCompositions  OfferComposition[]

  @@map("products")
}

model BusinessAccount {
  id                           String                        @id @default(uuid()) @db.Uuid
  code                         String                        @unique(map: "business_accounts_code_key")
  displayName                  String                        @map("display_name")
  active                       Boolean                       @default(true)
  createdAt                    DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  marketplaceAccounts          MarketplaceAccount[]
  olistAccounts                OlistAccount[]
  productExternalIdentities    ProductExternalIdentity[]
  marketplaceOrderBackfillRuns MarketplaceOrderBackfillRun[]

  @@map("business_accounts")
}

model MarketplaceAccount {
  id                 String                        @id @default(uuid()) @db.Uuid
  businessAccountId  String?                       @map("business_account_id") @db.Uuid
  marketplace        Marketplace
  externalAccountId  String                        @map("external_account_id")
  name               String
  active             Boolean                       @default(true)
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  authorization      MarketplaceAuthorization?
  listings           MarketplaceListing[]
  orders             MarketplaceOrder[]
  dailySellerMetrics DailySellerMetrics[]
  orderBackfillRuns  MarketplaceOrderBackfillRun[]
  businessAccount    BusinessAccount?              @relation(fields: [businessAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "marketplace_accounts_business_account_id_fkey")

  @@unique([marketplace, externalAccountId], map: "marketplace_accounts_marketplace_external_account_id_key")
  @@index([businessAccountId], map: "marketplace_accounts_business_account_id_idx")
  @@map("marketplace_accounts")
}

model DailySellerMetrics {
  id                    String              @id @default(uuid()) @db.Uuid
  marketplaceAccountId  String              @map("marketplace_account_id") @db.Uuid
  businessDate          DateTime            @map("business_date") @db.Date
  timezone              String
  geFinanceReportSha256 String?             @map("gefinance_report_sha256") @db.Char(64)
  geFinanceDailySha256  String?             @map("gefinance_daily_sha256") @db.Char(64)
  calculatedAt          DateTime            @map("calculated_at") @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  marketplaceAccount    MarketplaceAccount  @relation(fields: [marketplaceAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "daily_seller_metrics_marketplace_account_id_fkey")
  metrics               DailySellerMetric[]

  @@unique([marketplaceAccountId, businessDate], map: "daily_seller_metrics_account_business_date_key")
  @@index([businessDate], map: "daily_seller_metrics_business_date_idx")
  @@map("daily_seller_metrics")
}

model DailySellerMetric {
  id                   String                      @id @default(uuid()) @db.Uuid
  dailySellerMetricsId String                      @map("daily_seller_metrics_id") @db.Uuid
  name                 DailySellerMetricName
  value                Decimal?                    @db.Decimal(30, 10)
  source               DailySellerMetricSource
  status               DailySellerMetricStatus
  confidence           DailySellerMetricConfidence
  validationEvidence   Json                        @map("validation_evidence") @db.JsonB
  dailySellerMetrics   DailySellerMetrics          @relation(fields: [dailySellerMetricsId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "daily_seller_metric_daily_seller_metrics_id_fkey")

  @@unique([dailySellerMetricsId, name], map: "daily_seller_metric_snapshot_name_key")
  @@map("daily_seller_metric_values")
}

model MarketplaceAuthorization {
  id                    String             @id @default(uuid()) @db.Uuid
  marketplaceAccountId  String             @unique(map: "marketplace_authorizations_marketplace_account_id_key") @map("marketplace_account_id") @db.Uuid
  accessTokenEncrypted  String             @map("access_token_encrypted")
  refreshTokenEncrypted String             @map("refresh_token_encrypted")
  tokenType             String?            @map("token_type")
  scope                 String?
  expiresAt             DateTime           @map("expires_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  marketplaceAccount    MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "marketplace_authorizations_marketplace_account_id_fkey")

  @@map("marketplace_authorizations")
}

model OlistAccount {
  id                String              @id @default(uuid()) @db.Uuid
  businessAccountId String?             @map("business_account_id") @db.Uuid
  externalAccountId String              @unique(map: "olist_accounts_external_account_id_key") @map("external_account_id")
  name              String
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  authorization     OlistAuthorization?
  businessAccount   BusinessAccount?    @relation(fields: [businessAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "olist_accounts_business_account_id_fkey")

  @@index([businessAccountId], map: "olist_accounts_business_account_id_idx")
  @@map("olist_accounts")
}

model OlistAuthorization {
  id                    String                   @id @default(uuid()) @db.Uuid
  integrationKey        String                   @unique(map: "olist_authorizations_integration_key_key") @map("integration_key")
  olistAccountId        String                   @unique(map: "olist_authorizations_olist_account_id_key") @map("olist_account_id") @db.Uuid
  accessTokenEncrypted  String                   @map("access_token_encrypted")
  refreshTokenEncrypted String                   @map("refresh_token_encrypted")
  tokenType             String?                  @map("token_type")
  scope                 String?
  expiresAt             DateTime                 @map("expires_at") @db.Timestamptz(3)
  refreshExpiresAt      DateTime?                @map("refresh_expires_at") @db.Timestamptz(3)
  status                OlistAuthorizationStatus @default(ACTIVE)
  statusReason          String?                  @map("status_reason")
  lastRefreshAttemptAt  DateTime?                @map("last_refresh_attempt_at") @db.Timestamptz(3)
  lastRefreshSuccessAt  DateTime?                @map("last_refresh_success_at") @db.Timestamptz(3)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  olistAccount          OlistAccount             @relation(fields: [olistAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "olist_authorizations_olist_account_id_fkey")

  @@map("olist_authorizations")
}

enum OlistAuthorizationStatus {
  ACTIVE
  REAUTH_REQUIRED
}

model MarketplaceListing {
  id                   String                   @id @default(uuid()) @db.Uuid
  marketplaceAccountId String                   @map("marketplace_account_id") @db.Uuid
  externalListingId    String                   @map("external_listing_id")
  title                String?
  status               String?
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  marketplaceAccount   MarketplaceAccount       @relation(fields: [marketplaceAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "marketplace_listings_marketplace_account_id_fkey")
  items                MarketplaceListingItem[]

  @@unique([marketplaceAccountId, externalListingId], map: "marketplace_listings_account_external_listing_id_key")
  @@index([marketplaceAccountId], map: "marketplace_listings_marketplace_account_id_idx")
  @@map("marketplace_listings")
}

model MarketplaceListingItem {
  id                       String                    @id @default(uuid()) @db.Uuid
  marketplaceListingId     String                    @map("marketplace_listing_id") @db.Uuid
  productId                String?                   @map("product_id") @db.Uuid
  externalSellableId       String                    @map("external_sellable_id")
  sellerSku                String?                   @map("seller_sku")
  variationLabel           String?                   @map("variation_label")
  active                   Boolean                   @default(true)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  marketplaceListing       MarketplaceListing        @relation(fields: [marketplaceListingId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "marketplace_listing_items_marketplace_listing_id_fkey")
  product                  Product?                  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "marketplace_listing_items_product_id_fkey")
  orderItems               MarketplaceOrderItem[]
  externalIdentities       ProductExternalIdentity[]
  offerCompositions        OfferComposition[]
  leftListingEquivalences  ListingEquivalence[]      @relation("ListingEquivalenceLeft")
  rightListingEquivalences ListingEquivalence[]      @relation("ListingEquivalenceRight")

  @@unique([marketplaceListingId, externalSellableId], map: "marketplace_listing_items_listing_external_sellable_id_key")
  @@index([marketplaceListingId], map: "marketplace_listing_items_marketplace_listing_id_idx")
  @@index([productId], map: "marketplace_listing_items_product_id_idx")
  @@index([sellerSku], map: "marketplace_listing_items_seller_sku_idx")
  @@map("marketplace_listing_items")
}

model OfferComposition {
  id                       String                 @id @default(uuid()) @db.Uuid
  marketplaceListingItemId String                 @map("marketplace_listing_item_id") @db.Uuid
  componentProductId       String                 @map("component_product_id") @db.Uuid
  quantity                 Decimal                @db.Decimal(30, 10)
  source                   OfferCompositionSource
  confidence               Decimal                @db.Decimal(5, 4)
  evidenceVersion          String                 @map("evidence_version")
  evidenceHash             String                 @map("evidence_hash") @db.Char(64)
  /// Sanitized evidence only; credentials, tokens, and raw sensitive payloads are forbidden.
  evidence                 Json?                  @db.JsonB
  validFrom                DateTime               @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo                  DateTime?              @map("valid_to") @db.Timestamptz(3)
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  marketplaceListingItem   MarketplaceListingItem @relation(fields: [marketplaceListingItemId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "offer_compositions_marketplace_listing_item_id_fkey")
  componentProduct         Product                @relation(fields: [componentProductId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "offer_compositions_component_product_id_fkey")

  @@index([marketplaceListingItemId, validTo], map: "offer_compositions_listing_item_valid_to_idx")
  @@index([componentProductId, validTo], map: "offer_compositions_component_product_valid_to_idx")
  @@index([evidenceHash], map: "offer_compositions_evidence_hash_idx")
  @@map("offer_compositions")
}

model ListingEquivalence {
  id                 String                   @id @default(uuid()) @db.Uuid
  leftListingItemId  String                   @map("left_listing_item_id") @db.Uuid
  rightListingItemId String                   @map("right_listing_item_id") @db.Uuid
  componentSignature String                   @map("component_signature") @db.Char(64)
  status             ListingEquivalenceStatus
  confidence         Decimal                  @db.Decimal(5, 4)
  matchingVersion    String                   @map("matching_version")
  evidenceHash       String                   @map("evidence_hash") @db.Char(64)
  /// Sanitized evidence only; credentials, tokens, and raw sensitive payloads are forbidden.
  evidence           Json?                    @db.JsonB
  validFrom          DateTime                 @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo            DateTime?                @map("valid_to") @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  leftListingItem    MarketplaceListingItem   @relation("ListingEquivalenceLeft", fields: [leftListingItemId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "listing_equivalences_left_listing_item_id_fkey")
  rightListingItem   MarketplaceListingItem   @relation("ListingEquivalenceRight", fields: [rightListingItemId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "listing_equivalences_right_listing_item_id_fkey")

  @@index([leftListingItemId, validTo], map: "listing_equivalences_left_valid_to_idx")
  @@index([rightListingItemId, validTo], map: "listing_equivalences_right_valid_to_idx")
  @@index([componentSignature, status, validTo], map: "listing_equivalences_signature_status_valid_to_idx")
  @@index([evidenceHash], map: "listing_equivalences_evidence_hash_idx")
  @@map("listing_equivalences")
}

model ProductExternalIdentity {
  id                       String                  @id @default(uuid()) @db.Uuid
  productId                String                  @map("product_id") @db.Uuid
  businessAccountId        String                  @map("business_account_id") @db.Uuid
  provider                 ProductIdentityProvider
  sellerSku                String?                 @map("seller_sku")
  externalListingId        String?                 @map("external_listing_id")
  externalVariationId      String?                 @map("external_variation_id")
  marketplaceListingItemId String?                 @map("marketplace_listing_item_id") @db.Uuid
  validFrom                DateTime                @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo                  DateTime?               @map("valid_to") @db.Timestamptz(3)
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  product                  Product                 @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_external_identities_product_id_fkey")
  businessAccount          BusinessAccount         @relation(fields: [businessAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_external_identities_business_account_id_fkey")
  marketplaceListingItem   MarketplaceListingItem? @relation(fields: [marketplaceListingItemId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "product_external_identities_marketplace_listing_item_id_fkey")

  @@index([productId], map: "product_external_identities_product_id_idx")
  @@index([businessAccountId, provider], map: "product_external_identities_account_provider_idx")
  @@index([businessAccountId, provider, sellerSku], map: "product_external_identities_account_provider_seller_sku_idx")
  @@index([businessAccountId, provider, externalListingId, externalVariationId], map: "product_external_identities_external_sellable_idx")
  @@index([marketplaceListingItemId], map: "product_external_identities_listing_item_idx")
  @@map("product_external_identities")
}

model MarketplaceOrder {
  id                   String                 @id @default(uuid()) @db.Uuid
  marketplaceAccountId String                 @map("marketplace_account_id") @db.Uuid
  externalOrderId      String                 @map("external_order_id")
  normalizedStatus     MarketplaceOrderStatus @map("normalized_status")
  rawStatus            String?                @map("raw_status")
  soldAt               DateTime               @map("sold_at") @db.Timestamptz(3)
  closedAt             DateTime?              @map("closed_at") @db.Timestamptz(3)
  lastUpdatedAt        DateTime?              @map("last_updated_at") @db.Timestamptz(3)
  cancelledAt          DateTime?              @map("cancelled_at") @db.Timestamptz(3)
  currency             String                 @default("BRL")
  grossAmount          Decimal                @map("gross_amount") @db.Decimal(14, 2)
  paidAmount           Decimal?               @map("paid_amount") @db.Decimal(14, 2)
  refundedAmount       Decimal?               @map("refunded_amount") @db.Decimal(14, 2)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  marketplaceAccount   MarketplaceAccount     @relation(fields: [marketplaceAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "marketplace_orders_marketplace_account_id_fkey")
  items                MarketplaceOrderItem[]

  @@unique([marketplaceAccountId, externalOrderId], map: "marketplace_orders_account_external_order_id_key")
  @@index([marketplaceAccountId], map: "marketplace_orders_marketplace_account_id_idx")
  @@index([soldAt], map: "marketplace_orders_sold_at_idx")
  @@index([normalizedStatus], map: "marketplace_orders_normalized_status_idx")
  @@index([marketplaceAccountId, soldAt], map: "marketplace_orders_account_sold_at_idx")
  @@map("marketplace_orders")
}

model MarketplaceOrderItem {
  id                       String                  @id @default(uuid()) @db.Uuid
  marketplaceOrderId       String                  @map("marketplace_order_id") @db.Uuid
  marketplaceListingItemId String?                 @map("marketplace_listing_item_id") @db.Uuid
  productId                String?                 @map("product_id") @db.Uuid
  externalListingId        String                  @map("external_listing_id")
  externalSellableId       String                  @map("external_sellable_id")
  userProductId            String?                 @map("user_product_id")
  catalogProductId         String?                 @map("catalog_product_id")
  sellerSku                String?                 @map("seller_sku")
  title                    String?
  quantity                 Int
  unitPrice                Decimal                 @map("unit_price") @db.Decimal(14, 2)
  grossAmount              Decimal                 @map("gross_amount") @db.Decimal(14, 2)
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  marketplaceOrder         MarketplaceOrder        @relation(fields: [marketplaceOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "marketplace_order_items_marketplace_order_id_fkey")
  marketplaceListingItem   MarketplaceListingItem? @relation(fields: [marketplaceListingItemId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "marketplace_order_items_marketplace_listing_item_id_fkey")
  product                  Product?                @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "marketplace_order_items_product_id_fkey")

  @@unique([marketplaceOrderId, externalListingId, externalSellableId], map: "marketplace_order_items_order_listing_sellable_key")
  @@index([marketplaceOrderId], map: "marketplace_order_items_marketplace_order_id_idx")
  @@index([marketplaceListingItemId], map: "marketplace_order_items_marketplace_listing_item_id_idx")
  @@index([productId], map: "marketplace_order_items_product_id_idx")
  @@index([sellerSku], map: "marketplace_order_items_seller_sku_idx")
  @@index([externalSellableId], map: "marketplace_order_items_external_sellable_id_idx")
  @@index([externalListingId], map: "marketplace_order_items_external_listing_id_idx")
  @@map("marketplace_order_items")
}

model MarketplaceOrderBackfillRun {
  id                   String                          @id @default(uuid()) @db.Uuid
  marketplaceAccountId String                          @map("marketplace_account_id") @db.Uuid
  businessAccountId    String                          @map("business_account_id") @db.Uuid
  dateFrom             DateTime                        @map("date_from") @db.Timestamptz(3)
  dateTo               DateTime                        @map("date_to") @db.Timestamptz(3)
  chunkDays            Int                             @default(1) @map("chunk_days")
  maxRps               Decimal                         @default(1) @map("max_rps") @db.Decimal(10, 3)
  maxAttempts          Int                             @default(5) @map("max_attempts")
  status               MarketplaceOrderBackfillStatus  @default(PENDING)
  totalChunks          Int                             @map("total_chunks")
  completedChunks      Int                             @default(0) @map("completed_chunks")
  failedChunks         Int                             @default(0) @map("failed_chunks")
  attempts             Int                             @default(0)
  pagesProcessed       Int                             @default(0) @map("pages_processed")
  ordersProcessed      Int                             @default(0) @map("orders_processed")
  itemsMapped          Int                             @default(0) @map("items_mapped")
  itemsUnmapped        Int                             @default(0) @map("items_unmapped")
  executionId          String?                         @map("execution_id") @db.Uuid
  heartbeatAt          DateTime?                       @map("heartbeat_at") @db.Timestamptz(3)
  lastError            String?                         @map("last_error")
  startedAt            DateTime?                       @map("started_at") @db.Timestamptz(3)
  completedAt          DateTime?                       @map("completed_at") @db.Timestamptz(3)
  failedAt             DateTime?                       @map("failed_at") @db.Timestamptz(3)
  createdAt            DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)
  marketplaceAccount   MarketplaceAccount              @relation(fields: [marketplaceAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "marketplace_order_backfill_runs_marketplace_account_id_fkey")
  businessAccount      BusinessAccount                 @relation(fields: [businessAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "marketplace_order_backfill_runs_business_account_id_fkey")
  chunks               MarketplaceOrderBackfillChunk[]

  @@index([marketplaceAccountId, status], map: "marketplace_order_backfill_runs_account_status_idx")
  @@index([businessAccountId], map: "marketplace_order_backfill_runs_business_account_id_idx")
  @@map("marketplace_order_backfill_runs")
}

model MarketplaceOrderBackfillChunk {
  id              String                         @id @default(uuid()) @db.Uuid
  runId           String                         @map("run_id") @db.Uuid
  dateFrom        DateTime                       @map("date_from") @db.Timestamptz(3)
  dateTo          DateTime                       @map("date_to") @db.Timestamptz(3)
  status          MarketplaceOrderBackfillStatus @default(PENDING)
  nextOffset      Int                            @default(0) @map("next_offset")
  totalOrders     Int?                           @map("total_orders")
  attempts        Int                            @default(0)
  pagesProcessed  Int                            @default(0) @map("pages_processed")
  ordersProcessed Int                            @default(0) @map("orders_processed")
  itemsMapped     Int                            @default(0) @map("items_mapped")
  itemsUnmapped   Int                            @default(0) @map("items_unmapped")
  partial         Boolean                        @default(false)
  lastError       String?                        @map("last_error")
  startedAt       DateTime?                      @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime?                      @map("completed_at") @db.Timestamptz(3)
  failedAt        DateTime?                      @map("failed_at") @db.Timestamptz(3)
  createdAt       DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  run             MarketplaceOrderBackfillRun    @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "marketplace_order_backfill_chunks_run_id_fkey")

  @@unique([runId, dateFrom], map: "marketplace_order_backfill_chunks_run_date_from_key")
  @@index([runId, status], map: "marketplace_order_backfill_chunks_run_status_idx")
  @@map("marketplace_order_backfill_chunks")
}
