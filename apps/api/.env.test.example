# Copy to .env.test only for a disposable local PostgreSQL instance.
# Both URLs are checked before PrismaClient can connect.
# Rehearsal scripts can set DATABASE_SAFETY_MODE=test instead of changing NODE_ENV.
NODE_ENV=test
ALLOW_DISPOSABLE_TEST_DATABASE=true
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/ale_intelligence_test
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55432/ale_intelligence_test
