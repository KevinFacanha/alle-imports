{
  "name": "@ale-intelligence/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "build:test": "tsc --project tsconfig.test.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "npm run build:test && node --test dist-test/database/test-database-safety.spec.js dist-test/health/health.controller.spec.js dist-test/health/health.e2e.spec.js dist-test/modules/analytics/application/daily-sales-summary.service.spec.js dist-test/modules/analytics/application/daily-seller-metrics-backfill.service.spec.js dist-test/modules/analytics/application/daily-seller-metrics-persistence.service.spec.js dist-test/modules/analytics/application/daily-seller-metrics-query.service.spec.js dist-test/modules/analytics/application/gefinance-import.service.spec.js dist-test/modules/analytics/application/mercado-livre-metrics-reconciliation.service.spec.js dist-test/modules/analytics/application/seller-bi-metric.resolver.spec.js dist-test/modules/analytics/application/seller-metrics-reconciliation.service.spec.js dist-test/modules/integrations/gefinance/gefinance-report.provider.spec.js dist-test/modules/integrations/olist/olist-oauth.spec.js dist-test/modules/integrations/olist/olist-authorization.service.spec.js dist-test/modules/integrations/olist/olist-orders.client.spec.js dist-test/modules/integrations/olist/olist-orders-inspection.service.spec.js dist-test/modules/marketplaces/application/orders-ingestion.service.spec.js dist-test/modules/marketplaces/application/marketplace-order-backfill.service.spec.js dist-test/modules/marketplaces/mercado-livre/mercado-livre-orders.provider.spec.js dist-test/modules/marketplaces/mercado-livre/mercado-livre-orders-retry.spec.js dist-test/modules/marketplaces/mercado-livre/mercado-livre-catalog-sync.service.spec.js dist-test/modules/marketplaces/mercado-livre/oauth/mercado-livre-oauth.spec.js dist-test/modules/marketplaces/mercado-livre/oauth/marketplace-authorization.service.spec.js dist-test/modules/products/application/product-materialization.service.spec.js",
    "test:database": "npm run build:test && node --env-file=.env.test --test dist-test/database/database.service.spec.js",
    "analytics:daily-sales": "npm run build && node --env-file=.env dist/scripts/daily-sales-summary.js",
    "ingest:ml:orders": "npm run build && node --env-file=.env dist/scripts/ingest-ml-orders.js",
    "backfill:ml:orders": "npm run build && node --env-file=.env dist/scripts/backfill-ml-orders.js",
    "sync:ml-catalog": "npm run build && node --env-file=.env dist/scripts/sync-ml-catalog.js",
    "reconcile:ml:metrics": "npm run build && node --env-file=.env dist/scripts/reconcile-ml-metrics.js",
    "reconcile:seller-metrics": "npm run build && node --env-file=.env dist/scripts/reconcile-seller-metrics.js",
    "persist:seller-metrics": "npm run build && node --env-file=.env dist/scripts/persist-seller-metrics.js",
    "backfill:seller-metrics": "npm run build && node --env-file=.env dist/scripts/backfill-seller-metrics.js",
    "backfill:gefinance:daily-hashes": "npm run build && node --env-file=.env dist/scripts/backfill-gefinance-daily-hashes.js",
    "backfill:gefinance:margin-components": "npm run build && node --env-file=.env dist/scripts/backfill-gefinance-margin-components.js",
    "import:gefinance": "npm run build && node --env-file=.env dist/scripts/import-gefinance.js",
    "update:gefinance": "node --no-warnings=ExperimentalWarning --env-file=.env --loader ./scripts/typescript-loader.mjs ./scripts/run-update-gefinance.mjs",
    "update:gefinance:preflight": "npm run update:gefinance -- --preflight-only",
    "inspect:olist:orders": "npm run build && node --env-file=.env dist/scripts/inspect-olist-orders.js",
    "inspect:olist:only": "npm run build && node --env-file=.env dist/scripts/inspect-olist-only.js",
    "inspect:gefinance-report": "npm run build && node dist/scripts/inspect-gefinance-report.js",
    "list:integration:accounts": "npm run build && node --env-file=.env dist/scripts/list-integration-accounts.js",
    "materialize:products": "npm run build && node --env-file=.env dist/scripts/materialize-products.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@types/node": "^24.10.0",
    "prisma": "6.19.3",
    "typescript": "5.7.3"
  }
}
