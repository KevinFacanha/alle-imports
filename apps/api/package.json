{
  "name": "@ale-intelligence/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "build:test": "tsc --project tsconfig.test.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "npm run build:test && node --env-file=.env --test dist-test/database/database.service.spec.js dist-test/health/health.controller.spec.js dist-test/health/health.e2e.spec.js dist-test/modules/analytics/application/daily-sales-summary.service.spec.js dist-test/modules/marketplaces/application/orders-ingestion.service.spec.js dist-test/modules/marketplaces/mercado-livre/mercado-livre-orders.provider.spec.js dist-test/modules/marketplaces/mercado-livre/oauth/mercado-livre-oauth.spec.js dist-test/modules/marketplaces/mercado-livre/oauth/marketplace-authorization.service.spec.js",
    "analytics:daily-sales": "npm run build && node --env-file=.env dist/scripts/daily-sales-summary.js",
    "ingest:ml:orders": "npm run build && node --env-file=.env dist/scripts/ingest-ml-orders.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@types/node": "^24.10.0",
    "prisma": "6.19.3",
    "typescript": "5.7.3"
  }
}
